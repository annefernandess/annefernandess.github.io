---
import Zigzag from "./Zigzag.astro";
import { useT } from "../i18n";

const t = useT(Astro.currentLocale).academic;
// Glifos desenhados à mão (viewBox 64x64), na ordem de t.projects
const glyphs = [
  "M14 22c4-4 8-4 12-4h26M26 18c0 12-2 22-6 28M40 18c-1 12 0 22 6 26",
  "M32 10v18M32 28c-4 0-6 4-10 4M32 28c4 0 6 4 10 4M22 22c-8 4-10 20-8 26 2 5 10 4 12-2l2-18M42 22c8 4 10 20 8 26-2 5-10 4-12-2l-2-18",
  "M32 10v44M10 32h44M16 16l32 32M48 16 16 48M32 18l10 4 4 10-4 10-10 4-10-4-4-10 4-10ZM32 26l4 2 2 4-2 4-4 2-4-2-2-4 2-4Z",
  "M32 22a10 10 0 1 0 .01 0ZM32 10v6M32 48v6M10 32h6M48 32h6M16.5 16.5l4.2 4.2M43.3 43.3l4.2 4.2M47.5 16.5l-4.2 4.2M20.7 43.3l-4.2 4.2",
];
---

<section id="academicos" class="bg-sky">
  <Zigzag />
  <div class="px-4 py-16 md:px-10 md:py-20">
    <div class="mb-10 flex items-baseline justify-between">
      <p class="label">{t.num}</p>
      <p class="label">{t.range}</p>
    </div>
    <h2 class="text-center font-display text-heading-lg font-medium">
      {t.title}
    </h2>

    <ul class="mx-auto mt-12 grid max-w-6xl gap-3 md:grid-cols-2">
      {t.projects.map((p, i) => (
        <li class="relative flex gap-5 p-5">
          <span
            class="ink pointer-events-none absolute inset-0 border-2 border-ink"
            aria-hidden="true"
          />
          <svg
            viewBox="0 0 64 64"
            class="size-14 shrink-0 rounded-full bg-bone p-2"
            aria-hidden="true"
          >
            <path
              d={glyphs[i]}
              class="ink fill-none stroke-ink"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <div class="min-w-0">
            <p class="label">{p.course}</p>
            <h3 class="mt-1 font-display text-subheading font-medium">
              {p.name}
            </h3>
            <p class="mt-1 text-body-sm">{p.text}</p>
            <p class="mt-3 text-[12px]">{p.tags.join(" · ")}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
