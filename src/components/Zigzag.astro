---
// Faixa em zigue-zague (aceno à camisa do Charlie Brown)
const { class: className = "" } = Astro.props;
const id = `zz-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={`block h-4 w-full ${className}`} aria-hidden="true">
  <pattern id={id} width="32" height="16" patternUnits="userSpaceOnUse">
    <path
      d="M-8 12 0 4l8 8 8-8 8 8 8-8 8 8"
      class="fill-none stroke-ink"
      stroke-width="3"
    />
  </pattern>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
